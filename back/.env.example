PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://user:password@localhost:27017/?authSource=admin
DB_NAME=polypharmacy
OPENAI_API_KEY=sk-...
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Required in production to enable invite-only registration.
# Optional local-development fallback only. Production registration requires one-time invitations.
REGISTRATION_CODE=replace-with-a-local-development-code
APP_URL=http://localhost:5173
# Development: verification and reset links are printed only to the backend console.
# Production: set MAIL_MODE=smtp and configure SMTP_HOST, SMTP_FROM, and optionally SMTP_USER/SMTP_PASSWORD.
MAIL_MODE=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Polypharmacy Explorer <no-reply@example.com>
