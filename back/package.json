{
  "name": "back",
  "version": "1.0.0",
  "description": "Interactive graph of polypharmacy and cascade interactions",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "etl": "node --env-file-if-exists=.env src/scripts/import-registry.js",
    "test": "node --env-file-if-exists=.env --experimental-vm-modules node_modules/jest/bin/jest.js",
    "eval:rag": "node src/eval/run.js rag",
    "eval:agent": "node src/eval/run.js agent",
    "backfill:normalized-names": "node --env-file-if-exists=.env src/scripts/backfill-normalized-names.js",
    "invite": "node --env-file-if-exists=.env src/scripts/issue-invitation.js",
    "mail:worker": "node --env-file-if-exists=.env src/workers/mail.worker.js"
  },
  "keywords": [],
  "author": "Tatiana Iatskovskaia",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "express": "^5.2.1",
    "joi": "^18.2.9",
    "mongoose": "^9.7.3",
    "nodemailer": "^10.0.14",
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
